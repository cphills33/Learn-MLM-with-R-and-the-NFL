/*

# Track the public course entry point and course modules.
!/.gitignore
!/README.md
!/Week 0/
!/Week 0/**
!/Week 1/
!/Week 1/**

# Ignore system files and packaged downloads everywhere.
.DS_Store
*.zip

# Do not publish rendered or temporary Quarto files yet.
/Week 0/*.html
/Week 0/*_files/
/Week 0/*_cache/
/Week 0/.quarto/
/Week 1/*.html
/Week 1/*_files/
/Week 1/*_cache/
/Week 1/.quarto/
/Week 1/data/PROVENANCE.md
/Week 1/PLAN.md
/Week 1/build_data.R
/Week 1/check_wins.R

/.quarto/

# Publish only the ready Week 2 student materials.
!/Week 2/
/Week 2/*
!/Week 2/README.md
!/Week 2/Week_2_Worksheet.qmd
!/Week 2/helper-functions.R
!/Week 2/data/
/Week 2/data/*
!/Week 2/data/games_2025.csv
!/Week 2/data/PROVENANCE.md

# Week 3 student materials; keep rendered HTML previews local.
!/Week 3/
/Week 3/*
!/Week 3/README.md
!/Week 3/Week_3_Worksheet.qmd
!/Week 3/helper-functions.R
!/Week 3/week-03-my-plot.png
!/Week 3/data/
/Week 3/data/*
!/Week 3/data/games_2025.csv
!/Week 3/data/PROVENANCE.md

# Week 4 student materials; keep rendered previews local.
!/Week 4/
/Week 4/*
!/Week 4/README.md
!/Week 4/Week_4_Worksheet.qmd
!/Week 4/helper-functions.R
!/Week 4/week-04-my-plot.png
!/Week 4/data/
/Week 4/data/*
!/Week 4/data/games_2025.csv
!/Week 4/data/PROVENANCE.md
