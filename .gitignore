/*

# Track the public course entry point and course modules.
!/.gitignore
!/README.md
!/Week 0/
!/Week 0/**
!/Week 1/
!/Week 1/**

# Ignore system files and packaged downloads everywhere.
.DS_Store
*.zip

# Do not publish rendered or temporary Quarto files yet.
/Week 0/*.html
/Week 0/*_files/
/Week 0/*_cache/
/Week 0/.quarto/
/Week 1/*.html
/Week 1/*_files/
/Week 1/*_cache/
/Week 1/.quarto/
/Week 1/data/PROVENANCE.md
/Week 1/PLAN.md
/Week 1/build_data.R
/Week 1/check_wins.R

/.quarto/
