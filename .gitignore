/*

# Track only the public course entry point and Week 0.
!/.gitignore
!/README.md
!/Week 0/
!/Week 0/**

# Ignore system files and packaged downloads everywhere.
.DS_Store
*.zip

# Do not publish rendered or temporary Quarto files yet.
/Week 0/*.html
/Week 0/*_files/
/Week 0/*_cache/
/Week 0/.quarto/

